{
  "name": "biorotina",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "local": "node scripts/local.mjs",
    "local:api": "node scripts/local-api.mjs",
    "local:reset": "node scripts/local-reset.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test scripts/*.check.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test scripts vite.config.ts vitest.config.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write src test scripts index.html package.json vite.config.ts vitest.config.ts eslint.config.mjs",
    "format:check": "prettier --check src test scripts index.html package.json vite.config.ts vitest.config.ts eslint.config.mjs",
    "check": "npm run format:check && npm run lint && npm run check:secrets && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@ziglang/cli": "^0.0.14",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "serverless": "^3.40.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "tar": "^7.5.22",
    "adm-zip": "^0.6.1"
  }
}
